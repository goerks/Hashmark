{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "description": "Markdown-Präsentationen als navigierbarer Baum",
  "type": "module",
  "bin": {
    "strata": "./src/cli/index.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli/index.ts dev examples/strata-demo",
    "build": "node src/cli/index.ts build examples/strata-demo",
    "preview": "node src/cli/index.ts preview examples/strata-demo",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "cac": "7.0.0",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "svelte": "5.57.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "5.0.2"
  }
